# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Redis Storage
REDIS_URL=redis://default:password@host:port

# Admin Access
# Comma-separated list of Clerk user emails that have admin panel access (/admin)
ADMIN_EMAILS=your-email@example.com
# ADMIN_EMAILS=admin1@example.com,admin2@example.com

# Encryption key for KV-stored provider keys (generate with:)
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your-64-char-hex-key-here

# AIHubMix Provider
# Get from https://aihubmix.com
AIHUBMIX_KEY_1=sk_...

# Pollinations Provider
# Get sk_ keys from https://enter.pollinations.ai
# Add more keys as POLLINATIONS_KEY_2, POLLINATIONS_KEY_3, etc.
# Rate limits scale automatically: 60 req/min * number of keys
POLLINATIONS_KEY_1=sk_...
# POLLINATIONS_KEY_2=sk_...
# POLLINATIONS_KEY_3=sk_...

# VoidAI Provider
# Get sk_voidai-* keys from https://voidai.app
# Add more keys as VOIDAI_KEY_2, VOIDAI_KEY_3, etc.
# Rate limits scale automatically: 60 req/min * number of keys
VOIDAI_KEY_1=sk_voidai-...
# VOIDAI_KEY_2=sk_voidai-...
# VOIDAI_KEY_3=sk_voidai-...

# API.Airforce Provider
# Get sk-air-* keys from https://api.airforce
# Add more keys as AIRFORCE_KEY_2, AIRFORCE_KEY_3, etc.
# Rate limits scale automatically: 60 req/min * number of keys
AIRFORCE_KEY_1=sk-air-...
# AIRFORCE_KEY_2=sk-air-...
# AIRFORCE_KEY_3=sk-air-...

# Cerebras Provider
# Get cs_* keys from https://api.cerebras.ai
# Free tier: 1M tokens/day per key. Rate limits scale automatically: 60 req/min * number of keys
# Models: llama-3.3-70b, llama-4-scout, deepseek-r1 (text only)
CEREBRAS_KEY_1=cs_...
# CEREBRAS_KEY_2=cs_...
# CEREBRAS_KEY_3=cs_...
